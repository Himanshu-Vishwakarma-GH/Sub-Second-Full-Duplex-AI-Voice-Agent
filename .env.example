# ========================================================
# 100% Free Cloud API Credentials (Zero Credit Card Required)
# ========================================================

# 1. Groq Cloud (Free Llama 3.3 70B inference @ ~300 tokens/sec)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Deepgram Cloud (Free $200 credits for streaming STT Nova-2)
# Get your free key at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 3. LiveKit Cloud (Free 50GB WebRTC streaming bandwidth/month)
# Get your free credentials at: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey_xxxx
LIVEKIT_API_SECRET=secret_xxxx

# 4. Optional TTS Configuration (Defaults to free Edge-TTS neural voice)
TTS_VOICE=en-US-ChristopherNeural
